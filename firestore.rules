rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    match /users/{userId} {

      allow read, write: if request.auth != null && request.auth.uid == userId;

    }

    match /circles/{circleId} {

      allow create: if request.auth != null && request.resource.data.adminId == request.auth.uid;

      allow read: if request.auth != null;

      allow update: if request.auth != null && (

        resource.data.adminId == request.auth.uid ||

        (

          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberCount"]) &&

          request.resource.data.memberCount >= 0 &&

          request.resource.data.memberCount <= resource.data.maxMembers

        )

      );

      allow delete: if request.auth != null && resource.data.adminId == request.auth.uid;

      match /members/{memberId} {

        allow read: if request.auth != null;

        allow create: if request.auth != null &&

          request.auth.uid == memberId &&

          exists(/databases/$(database)/documents/circles/$(circleId)) &&

          get(/databases/$(database)/documents/circles/$(circleId)).data.memberCount <

          get(/databases/$(database)/documents/circles/$(circleId)).data.maxMembers;

        allow update: if request.auth != null && (

          request.auth.uid == memberId ||

          get(/databases/$(database)/documents/circles/$(circleId)).data.adminId == request.auth.uid

        );

        allow delete: if request.auth != null && (

          request.auth.uid == memberId ||

          get(/databases/$(database)/documents/circles/$(circleId)).data.adminId == request.auth.uid

        );

      }

      match /rounds/{roundId} {

        allow read: if request.auth != null;

        allow create: if request.auth != null &&

          get(/databases/$(database)/documents/circles/$(circleId)).data.adminId == request.auth.uid;

        allow update: if request.auth != null &&

          get(/databases/$(database)/documents/circles/$(circleId)).data.adminId == request.auth.uid &&

          request.resource.data.diff(resource.data).affectedKeys().hasOnly([

            "number",

            "status",

            "createdAt",

            "payoutRecipientId",

            "payoutRecipientEmail",

            "payoutRecipientUserId",

            "completedAt"

          ]);

        allow delete: if request.auth != null &&

          get(/databases/$(database)/documents/circles/$(circleId)).data.adminId == request.auth.uid;

        match /contributions/{userId} {

          allow read: if request.auth != null;

          allow create: if request.auth != null &&

            get(/databases/$(database)/documents/circles/$(circleId)).data.adminId == request.auth.uid;

          allow update: if request.auth != null && (

            request.auth.uid == userId ||

            get(/databases/$(database)/documents/circles/$(circleId)).data.adminId == request.auth.uid

          ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([

            "userId",

            "email",

            "amount",

            "status",

            "createdAt"

          ]);

          allow delete: if request.auth != null && (

            request.auth.uid == userId ||

            get(/databases/$(database)/documents/circles/$(circleId)).data.adminId == request.auth.uid

          );

        }

      }

    }

  }

}
